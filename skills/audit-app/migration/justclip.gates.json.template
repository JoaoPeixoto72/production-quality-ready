{
  "//": "Template para JustClip/.claude/gates.json — pack de gates de projecto",
  "//1": "Compatível com production-quality-ready evidence-schema: 1.3.x",
  "//2": "Vive em JustClip/.claude/gates.json (não neste plugin)",
  "//3": "Ver POLICY §5.1 do plugin para semântica completa",

  "plugin": "production-quality-ready",
  "plugin-version": "1.3.x",

  "owners": {
    "audit-app":            {},
    "code-review-runtime":  { "adapter": "code-review-runtime.local.md" },
    "code-review-contract": { "adapter": "code-review-contract.local.md" },
    "ui-system":            {},
    "design-pro":           {},
    "security-audit":       { "adapter": "security-audit.local.md" },
    "reliability-audit":    { "adapter": "reliability-audit.local.md" },
    "performance-audit":    { "adapter": "performance-audit.local.md" },
    "observability":        {},
    "release-audit":        { "adapter": "release-audit.local.md" },
    "commercial-readiness": { "sells": true },
    "seo-audit":            { "not-applicable": "sem superfície web indexável" }
  },

  "adapter-hints": {
    "//": "Lido apenas por adapters locais. Nunca pelo audit-app (POLICY §5.1.4)",
    "build-command":     "cd src-tauri && cargo build --release --locked",
    "tests-command":     "cd src-tauri && cargo test --workspace",
    "typecheck-command": "npm run build"
  },

  "gates": ["release-candidate", "production-ready", "sellable"],

  "//4": "Baselines da 2.3.x da auditar-app original ficam em",
  "//5": ".claude/skills/auditar-app/baselines/ enquanto essa skill viver",
  "//6": "no repo. Não migram para este ficheiro."
}
