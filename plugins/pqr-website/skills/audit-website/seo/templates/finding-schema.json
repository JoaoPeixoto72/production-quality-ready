{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeoAuditReport",
  "type": "object",
  "required": ["meta", "findings"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["target", "verdict", "confidence"],
      "properties": {
        "target": { "type": "string" },
        "verdict": { "type": "string" },
        "confidence": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "severity", "status", "evidenceClass"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string" },
          "status": { "type": "string" },
          "evidenceClass": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": ["object", "array", "string", "null"] }
        }
      }
    }
  }
}
